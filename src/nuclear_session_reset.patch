+
+    def _should_trigger_nuclear_reset(self, error: Exception) -> bool:
+        """
+        Determine if an error is critical enough to warrant nuclear reset
+        """
+        error_str = str(error).lower()
+        error_type = type(error).__name__
+        
+        # Critical errors that indicate corrupted session
+        critical_patterns = [
+            'bad file descriptor',
+            'unpack requires a buffer',
+            'connection reset by peer',
+            'broken pipe',
+            'connection aborted',
+        ]
+        
+        # Check error message
+        for pattern in critical_patterns:
+            if pattern in error_str:
+                return True
+        
+        # Check error type
+        if error_type in ['OSError', 'struct.error', 'ConnectionResetError', 'BrokenPipeError']:
+            # For OSError, check errno if available
+            if isinstance(error, OSError) and hasattr(error, 'errno'):
+                if error.errno in [9, 32, 104]:  # EBADF, EPIPE, ECONNRESET
+                    return True
+            return True
+        
+        return False
     
